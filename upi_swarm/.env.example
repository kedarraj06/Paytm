# Fill these in. Values here override ../.env. Leave a line as-is (or blank) to keep using the value from ../.env.
# Never commit this file.

# ---- Supabase (REST mirror of all upi_* tables) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# ---- Supabase direct Postgres (only used by apply_schema.py to create the tables once) ----
# Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ---- Neo4j AuraDB ----
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-neo4j-username
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=your-neo4j-database

# ---- Gemini (optional wording polish; app works without it) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
USE_LLM=1
